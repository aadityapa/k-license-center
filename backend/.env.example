# ---- Server (Python / FastAPI; started by start.bat or `python run.py`) ----
PORT=3001
# development | production
NODE_ENV=development
LOG_LEVEL=info

# ---- Demo ----
# The server always runs on PostgreSQL. For demo data load
# database/postgres/demo/demo_data.sql into a NON-production database.
#
# Demo only: skip admin login entirely (every request acts as admin).
# Refused at startup when NODE_ENV=production.
AUTH_DISABLED=false

# ---- PostgreSQL ----
# Create the role and database in pgAdmin first (see database/postgres/README.md),
# then build the tables with:  python -m scripts.db_migrate   (or start.bat)
# (the API also applies new database/postgres/NNN_*.sql files when it starts).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=klicense
DB_USER=klicense
DB_PASSWORD=change-me
# Or one URL instead of the five lines above (wins when set):
# DATABASE_URL=postgres://klicense:change-me@localhost:5432/klicense
# true for a managed/cloud PostgreSQL that requires TLS:
DB_SSL=false
# Pin "today" for licence expiry, e.g. Asia/Kolkata. Empty = the server's zone.
DB_TIMEZONE=

# ---- Admin auth ----
# Required in production; use a long random string (>= 32 chars).
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# ---- Licence signing (run `python -m scripts.keygen` in backend\ to generate both) ----
# Private keys. Server only: never commit them, never store them in the
# database, never ship them to a customer. Embed only the PUBLIC halves in the
# products, which can then verify a licence but not create one.
#
# Ed25519, signs .lic activation files for KStack / KFlash:
LICENCE_SIGNING_KEY=
# ECDSA P-256, signs Vehicle SIM V3 key strings. A different curve because
# Vehicle SIM is .NET 8, which ships no Ed25519 type but does ship ECDsa, so
# P-256 lets it verify with nothing but the base class library:
VBS_SIGNING_KEY=

# ---- Outgoing email (leave unset to queue only, visible in Email Outbox) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Karnex License Center <no-reply@karnex.in>

# ---- CORS (comma-separated allowlist of admin UI origins) ----
CORS_ORIGINS=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LICENSE_WINDOW_MS=60000
RATE_LIMIT_LICENSE_MAX=120
