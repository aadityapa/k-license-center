# deploy/.env — production settings for docker-compose.yml. Copy to deploy/.env and fill in.
# This file holds secrets: chmod 600, never commit it, keep a copy in a password manager.

# ---- Public address ----
# DNS A record of this name -> the EC2 Elastic IP. Apps use https://<DOMAIN>/api/v1
DOMAIN=license.example.com
ACME_EMAIL=karan.singh@karnex.in
# Portal sign-in / admin API only from these networks (space separated CIDRs),
# e.g. "203.0.113.10/32" for the office. Default: anywhere (login still required).
ADMIN_ALLOW_CIDRS=0.0.0.0/0 ::/0
TZ=Asia/Kolkata

# ---- Database (PostgreSQL container) ----
# Long random value:  openssl rand -base64 30
DB_PASSWORD=
DB_TIMEZONE=Asia/Kolkata
BACKUP_KEEP_DAYS=14

# ---- Admin sessions ----
# >= 32 chars:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Licence signing keys ----
# Generate ONCE:  docker compose run --rm --no-deps -e NODE_ENV=development api python -m scripts.keygen
# Paste the two PRIVATE keys here. Put the P-256 PUBLIC key into the apps with
# backend\scripts\set_app_public_key (see AWS-DEPLOY.md). Rotating later invalidates every key issued.
LICENCE_SIGNING_KEY=
VBS_SIGNING_KEY=

# ---- Outgoing e-mail (optional; empty = queued only, visible in Email Outbox) ----
# Amazon SES SMTP: email-smtp.<region>.amazonaws.com, port 587, SES SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Karnex License Center <no-reply@karnex.in>

LOG_LEVEL=info
AUTH_DISABLED=false
